# Server-only variables for Wakefield. Copy to .env.server for local dev,
# and set them on the Space with `sf env set NAME --secret` for production.

# Required for the AI GM. Without it, the backup narrator runs the game.
ANTHROPIC_API_KEY=

# Required for the AI GM: signs GM beats so players can't forge them.
# Generate with: openssl rand -hex 32
GM_SIGNING_KEY=

# Optional. Defaults: claude-opus-5-5 at low effort.
GM_MODEL=
GM_EFFORT=
